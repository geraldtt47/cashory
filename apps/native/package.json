{
  "name": "native",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo run:android --device",
    "android:release:test": "node scripts/run-android-device.mjs test",
    "android:release:prod": "node scripts/run-android-device.mjs prod",
    "android:standalone": "bun run android:release:prod",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:clean": "node scripts/prebuild-clean.mjs",
    "prebuild:android:clean": "node scripts/prebuild-clean.mjs android",
    "prebuild:ios:clean": "node scripts/prebuild-clean.mjs ios",
    "keystore:create": "node scripts/create-keystore.mjs",
    "build:aab": "node scripts/build-aab.mjs",
    "build:apk": "node scripts/build-apk.mjs",
    "verify:signature": "node scripts/verify-signature.mjs",
    "clear:cache": "expo start -c && bunx rimraf android/app/build ios/build",
    "web": "expo start --web"
  },
