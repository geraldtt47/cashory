EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Bun monorepo: Metro server root at apps/native (Gradle release embed paths). Workspace
# packages are wired in metro.config.js watchFolders / nodeModulesPaths.
EXPO_NO_METRO_WORKSPACE_ROOT=1

# Android release signing (prod installs only; copy to .env.local)
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_PASSWORD=
# ANDROID_KEY_ALIAS=upload