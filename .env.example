# Docker Compose / local infra. Created by: bun run setup:local-env
# App env files are separate: apps/server/.env and apps/native/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cashory
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cashory

# Mailpit SMTP on the host (UI is http://127.0.0.1:8026). Not wired into the API yet.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
