{
  "name": "cashory-demo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "better-auth": "1.5.2",
      "@better-auth/expo": "1.5.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @cashory-demo/db db:push",
    "db:studio": "turbo -F @cashory-demo/db db:studio",
    "db:generate": "turbo -F @cashory-demo/db db:generate",
    "db:migrate": "turbo -F @cashory-demo/db db:migrate",
    "docker:compose": "docker compose -p cashory-demo --env-file .env -f compose/docker-compose.yml -f compose/docker-compose.local.yml",
    "docker:infra:up": "node scripts/docker-infra-up.mjs",
    "docker:infra:down": "bun run docker:compose -- down",
    "docker:infra:verify": "node scripts/docker-infra-verify.mjs",
    "setup:local-env": "node scripts/setup-local-env.mjs",
    "setup:app-env": "node scripts/setup-app-env.mjs",
    "mobile:android": "cd apps/native && bun run android",
    "mobile:android:release:test": "cd apps/native && bun run android:release:test",
    "mobile:android:release": "cd apps/native && bun run android:release:prod",
    "mobile:ios": "cd apps/native && bun run ios",
    "mobile:prebuild": "cd apps/native && bun run prebuild",
    "mobile:prebuild:android": "cd apps/native && bun run prebuild:android",
    "mobile:prebuild:ios": "cd apps/native && bun run prebuild:ios",
    "mobile:prebuild:clean": "cd apps/native && bun run prebuild:clean",
    "mobile:prebuild:android:clean": "cd apps/native && bun run prebuild:android:clean",
    "mobile:prebuild:ios:clean": "cd apps/native && bun run prebuild:ios:clean",
    "mobile:keystore:create": "cd apps/native && bun run keystore:create",
    "mobile:build:aab": "cd apps/native && bun run build:aab",
    "mobile:build:apk": "cd apps/native && bun run build:apk",
    "mobile:verify:signature": "cd apps/native && bun run verify:signature"
  },
  "dependencies": {
    "@cashory-demo/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cashory-demo/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.9.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.2.19"
}
